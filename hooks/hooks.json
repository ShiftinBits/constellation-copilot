{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node ./hooks/inject.js sessionStart",
        "powershell": "node ./hooks/inject.js sessionStart",
        "timeoutSec": 5,
        "comment": "Inject Constellation code_intel preference at session start"
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node ./hooks/bash.js",
        "powershell": "node ./hooks/bash.js",
        "timeoutSec": 5,
        "comment": "Nudge toward code_intel for search tools and Bash search commands"
      }
    ]
  }
}
